{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyBrain",
  "version": "0.1.0",
  "identifier": "app.mybrain.desktop",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "MyBrain", "width": 1200, "height": 800 }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["$APPDATA/**", "$APPLOCALDATA/**"] } }
  },
  "bundle": { "active": true, "targets": ["nsis", "msi"], "icon": ["icons/icon.ico", "icons/icon.png"] }
}
